# Obtain these from a restricted Tencent Cloud CAM sub-account. Do not put them in the canvas settings.
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=example-1234567890
COS_REGION=ap-guangzhou

# The browser receives a signed GET URL valid for this long. COS remains private.
SIGNED_URL_TTL_SECONDS=86400

# This service only listens locally. Set the same optional value in the AICopy channel's upload token field.
MEDIA_GATEWAY_TOKEN=
PORT=8787
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
