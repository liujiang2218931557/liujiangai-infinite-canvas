# Tencent Cloud SCF media gateway configuration. Set these in SCF environment
# variables, not in the browser and not in Git.
COS_BUCKET=example-1234567890
COS_REGION=ap-guangzhou
SIGNED_URL_TTL_SECONDS=86400
MAX_UPLOAD_BYTES=104857600
DEFAULT_DAILY_BYTES=5368709120
# Generate a separate random token for every user. This is a fake value only.
MEDIA_GATEWAY_USERS_JSON=[{"id":"demo-user","token":"replace-with-a-random-token","dailyBytes":5368709120}]
# Optional local fallback only. Prefer the SCF service role or restricted CAM role.
COS_SECRET_ID=
COS_SECRET_KEY=
TENCENTCLOUD_SECRETID=
TENCENTCLOUD_SECRETKEY=
TENCENTCLOUD_SESSIONTOKEN=
