# This static canvas has no required root environment variables.
# Never add a New API user key, administrator key, upstream key, server password,
# COS credential, cookie, or upload token to this file.
#
# Optional analytics identifiers are consumed by the Docker runtime config only.
ANALYTICS_GA4_ID=G-XXXXXXXXXX
ANALYTICS_BAIDU_ID=replace-with-baidu-site-id
#
# Media gateway settings are intentionally split by deployment target:
# - media-gateway/.env.example: local Node gateway only
# - cloud-media-gateway/.env.example: Tencent Cloud SCF deployment
